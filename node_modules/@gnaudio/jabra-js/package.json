{
  "name": "@gnaudio/jabra-js",
  "description": "Controls Jabra devices from JavaScript. Supports both Node.js and browser.",
  "version": "4.3.5",
  "author": "GN Audio A/S",
  "homepage": "https://developer.jabra.com/",
  "license": "SEE LICENSE IN: LICENSE",
  "type": "module",
  "main": "./browser-esm/index.js",
  "module": "./browser-esm/index.js",
  "typings": "./typings/index.d.ts",
  "files": [
    "browser-esm",
    "browser-umd",
    "node-cjs",
    "node-esm",
    "jabra-device-connector",
    "package.json",
    "LICENSE",
    "typings"
  ],
  "engines": {
    "node": ">=16.0.0"
  },
  "exports": {
    ".": {
      "node": {
        "import": "./node-esm/index.js",
        "require": "./node-cjs/index.js"
      },
      "default": "./browser-esm/index.js"
    },
    "./browser-esm/index.js": "./browser-esm/index.js",
    "./browser-esm": "./browser-esm/index.js",
    "./browser-umd/index.js": "./browser-umd/index.js",
    "./browser-umd": "./browser-umd/index.js",
    "./node-esm/index.js": "./node-esm/index.js",
    "./node-esm": "./node-esm/index.js",
    "./node-cjs/index.js": "./node-cjs/index.js",
    "./node-cjs": "./node-cjs/index.js"
  },
  "dependencies": {
    "pure-uuid": "1.8.1",
    "rxjs": "^7.8.2"
  }
}